{
  "api": {
    "base_url": "https://archive-api.open-meteo.com/v1/archive",
    "free_tier_limits": {
      "requests_per_minute": 60,
      "rate_limit_description": "Free tier allows ~60 requests/min for historical data"
    },
    "timeout_seconds": 30
  },
  "geographic_bounds": {
    "latitude": {
      "min": 5,
      "max": 80
    },
    "longitude": {
      "min": 25,
      "max": 180
    },
    "grid_resolution_degrees": 5.0,
    "region_name": "asia"
  },
  "variables": {
    "hourly": [
      "temperature_2m",
      "precipitation",
      "weather_code",
      "wind_speed_10m",
      "wind_direction_10m",
      "relative_humidity_2m"
    ]
  },
  "data_retention": {
    "window_days": 7,
    "hourly_records_per_day": 24,
    "total_hourly_records": 168,
    "refresh_schedule": "Every 6 hours on the hour (UTC)",
    "refresh_frequency": "Every 6 hours",
    "jitter_minutes": 10,
    "note": "GitHub Actions runs at :00 minutes every 6 hours with ±10 minute jitter"
  },
  "output": {
    "manifest_path": "../docs/data/manifest.json",
    "data_directory": "../docs/data/streaming",
    "format": "json",
    "grid_type": "regular_5degree_asia"
  }
}
